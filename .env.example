SAV_ANALYTICS_DATA_DIR=.data
SAV_ANALYTICS_MAX_UPLOAD_BYTES=262144000

# База метаданных. Пусто — SQLite в DATA_DIR. compose.yaml задаёт PostgreSQL сам.
SAV_ANALYTICS_DATABASE_URL=

# Production-контур (compose.yaml): пароль базы и домен для HTTPS.
POSTGRES_PASSWORD=
SAV_DOMAIN=

# Вход (P4). false — локальная работа без учётных записей.
SAV_ANALYTICS_AUTH_ENABLED=true
SAV_ANALYTICS_SESSION_TTL_HOURS=12
SAV_ANALYTICS_SESSION_IDLE_MINUTES=120

# Задания (P5): embedded — исполняет процесс API, external — sav-analytics-worker.
SAV_ANALYTICS_JOB_RUNNER=embedded
SAV_ANALYTICS_WORKER_CONCURRENCY=2
SAV_ANALYTICS_REPORT_TIMEOUT_SECONDS=1800

# Эксплуатация (P6): токен для /metrics, формат журнала text | json.
SAV_ANALYTICS_METRICS_TOKEN=
SAV_ANALYTICS_LOG_FORMAT=text


# Ассистент «Таблиц»: OpenAI-совместимый провайдер. Пустые — ассистент выключен.
# Подписи анкеты уходят провайдеру, ответы респондентов — нет (решение 030).
SAV_ANALYTICS_ASSISTANT_BASE_URL=
SAV_ANALYTICS_ASSISTANT_API_KEY=
SAV_ANALYTICS_ASSISTANT_MODEL=

# Заявки на демо с лендинга: журнал .data/demo_requests.jsonl пишется всегда,
# письмо уходит, только если заданы получатель и SMTP-сервер.
SAV_ANALYTICS_DEMO_MAIL_TO=
SAV_ANALYTICS_SMTP_HOST=
SAV_ANALYTICS_SMTP_PORT=587
SAV_ANALYTICS_SMTP_USER=
SAV_ANALYTICS_SMTP_PASSWORD=
SAV_ANALYTICS_SMTP_FROM=
