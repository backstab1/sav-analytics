SAV_ANALYTICS_DATA_DIR=.data
SAV_ANALYTICS_MAX_UPLOAD_BYTES=262144000


# Ассистент «Таблиц»: OpenAI-совместимый провайдер. Пустые — ассистент выключен.
# Подписи анкеты уходят провайдеру, ответы респондентов — нет (решение 030).
SAV_ANALYTICS_ASSISTANT_BASE_URL=
SAV_ANALYTICS_ASSISTANT_API_KEY=
SAV_ANALYTICS_ASSISTANT_MODEL=

# Заявки на демо с лендинга: журнал .data/demo_requests.jsonl пишется всегда,
# письмо уходит, только если заданы получатель и SMTP-сервер.
SAV_ANALYTICS_DEMO_MAIL_TO=
SAV_ANALYTICS_SMTP_HOST=
SAV_ANALYTICS_SMTP_PORT=587
SAV_ANALYTICS_SMTP_USER=
SAV_ANALYTICS_SMTP_PASSWORD=
SAV_ANALYTICS_SMTP_FROM=
